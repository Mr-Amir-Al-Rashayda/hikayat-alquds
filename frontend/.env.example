# --- Hikaya backend ----------------------------------------------------------
# Server-only address of the Hikaya API. Browsers use the same-origin
# `/api/v1` bridge, so phones do not need the computer's Wi-Fi IP address.
HIKAYA_API_BASE_URL="http://127.0.0.1:3000/api/v1"

# --- Dev server --------------------------------------------------------------
# The frontend listens on 5173 so it does not collide with the backend on 3000.
PORT=5173

# --- Natural narration (optional) --------------------------------------------
# Enables the warm online guide voice used by every location story. Without it,
# narration falls back to the best Arabic/English speech voice on the device and
# the interface clearly identifies that fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: public URL when deployed (optional for local development).
APP_URL="MY_APP_URL"
