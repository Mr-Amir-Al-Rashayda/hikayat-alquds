# Copy to keystore.properties and fill in. Never commit the real file.
#
# The release variant reads these, or the matching HIKAYAT_* environment
# variables, so CI can sign without a keystore file on disk. With neither
# present the release build falls back to the debug key - installable for
# testing, and impossible to mistake for a shippable artifact.
storeFile=../release.keystore
storePassword=
keyAlias=hikayat
keyPassword=
