<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later. Same rule as the legacy backup config: carry the
  reader's settings and journey across, and rebuild the archive from the
  installed app rather than restoring a copy of it.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
